# HE DIY Performance Console - optional configuration.
#
# NOTHING HERE IS REQUIRED. The app boots and serves the bundled snapshot with
# no file at all; only the "Refresh Redash" button needs a key.
#
# WHERE TO PUT THIS FILE
#   Best:  $APP_DATA_DIR/.env        survives a redeploy
#   Also:  backend/.env              wiped when a new ZIP is uploaded
#   Also:  <zip root>/.env           wiped when a new ZIP is uploaded
#
# Better still on a managed server: set the variable in the app server's own
# environment configuration and ship no file. The environment always wins over
# a file, so a stale .env cannot override a rotated key.

Common Dash=YOUR_COMMON_REDASH_API_KEY

# Any of these names work; the first one found is used:
#   Common Dash, COMMON_DASH, COMMON_REDASH_API_KEY, REDASH_API_KEY

# Optional, all with safe defaults:
# REDASH_HOST=https://common-redash.mmt.live
# REDASH_VERIFY_TLS=1
